# Source clones — cloned separately per user and not part of the workspace repo
# NOTE: no trailing slash, so the pattern matches `repos` at any depth: this
# top-level directory, and the `repos/` folders still nested inside worktrees
# left over from the session lifecycle of earlier template versions.
repos

# Work sessions — kept for workspaces that still hold folders from the session
# lifecycle of earlier template versions. New work never writes here;
# /migrate-sessions drains what is left.
work-sessions/

# Disposable workspace-scoped scratchpad (session log, hook debug output)
workspace-scratchpad/

# Staged template payload — transient input for /workspace-update, never tracked
.workspace-update/

# Personal overrides
.claude/settings.local.json
# A pointer file the session lifecycle of earlier template versions wrote inside
# each of its worktrees; a leftover stays ignored.
.claude/.active-session.json
CLAUDE.local.md

# Worktrees of the workspace repo itself — task worktrees (repo ".") and
# Claude Code's native worktrees both live under .claude/worktrees/
.claude/worktrees/

# Local-only convention — machine-local state, any depth
local-only-*

# IDE
.idea/

# OS
.DS_Store
Thumbs.db

# Per-user workspace-context indexes are generated per machine and read only
# through CLAUDE.local.md, which is itself gitignored — no mechanism reads
# another user's index. Regenerated by build-workspace-context.mjs on demand.
workspace-context/team-member/*/index.md
